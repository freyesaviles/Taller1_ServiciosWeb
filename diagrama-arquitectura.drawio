<mxfile host="app.diagrams.net">
  <diagram name="Arquitectura API Productos" id="arq1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Cliente / Postman -->
        <mxCell id="cliente" value="Cliente / Postman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Contenedor Spring Boot -->
        <mxCell id="springboot" value="Aplicacion Spring Boot" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="440" height="260" as="geometry" />
        </mxCell>

        <mxCell id="dispatcher" value="DispatcherServlet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="controller" value="ProductoController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="jackson" value="Jackson (Java &lt;-&gt; JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="130" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Productos en memoria -->
        <mxCell id="memoria" value="Productos en memoria&#10;(List&lt;Producto&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Flujo exitoso -->
        <mxCell id="e1" value="1. GET /api/productos/3" style="html=1;strokeColor=#006400;fontColor=#006400;" edge="1" parent="1" source="cliente" target="dispatcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. enruta al metodo" style="html=1;strokeColor=#006400;fontColor=#006400;" edge="1" parent="1" source="dispatcher" target="controller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. busca id=3" style="html=1;strokeColor=#006400;fontColor=#006400;" edge="1" parent="1" source="controller" target="memoria">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. objeto Producto encontrado" style="html=1;strokeColor=#006400;fontColor=#006400;" edge="1" parent="1" source="memoria" target="controller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. Producto -&gt; JSON" style="html=1;strokeColor=#006400;fontColor=#006400;" edge="1" parent="1" source="controller" target="jackson">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. 200 OK + JSON" style="html=1;strokeColor=#006400;fontColor=#006400;" edge="1" parent="1" source="jackson" target="cliente">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="300" />
              <mxPoint x="130" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Flujo 404 -->
        <mxCell id="f1" value="1. GET /api/productos/999" style="html=1;strokeColor=#a94442;fontColor=#a94442;dashed=1;" edge="1" parent="1" source="cliente" target="dispatcher">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="60" />
              <mxPoint x="470" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="f2" value="2. busca id=999" style="html=1;strokeColor=#a94442;fontColor=#a94442;dashed=1;" edge="1" parent="1" source="controller" target="memoria">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="3. no existe (Optional vacio)" style="html=1;strokeColor=#a94442;fontColor=#a94442;dashed=1;" edge="1" parent="1" source="memoria" target="controller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="4. 404 Not Found (sin cuerpo)" style="html=1;strokeColor=#a94442;fontColor=#a94442;dashed=1;" edge="1" parent="1" source="controller" target="cliente">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="350" />
              <mxPoint x="130" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="leyenda" value="Linea solida verde = recorrido exitoso (200 OK)&#10;Linea punteada roja = recorrido de recurso inexistente (404 Not Found)" style="text;html=1;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="500" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
